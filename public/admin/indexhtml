<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Overview SIMBA-IN - PT Aetra Air Tangerang</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: { sans: ['Poppins', 'sans-serif'] },
          colors: {
            aetra: {
              blue: '#0055A5', darkblue: '#003E78', orange: '#E86216', lightorange: '#FFF2EA', lightblue: '#E6F0FA'
            }
          }
        }
      }
    }
  </script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
  <style> body { font-family: 'Poppins', sans-serif; } </style>
</head>
<body class="bg-slate-100 dark:bg-slate-900 text-slate-800 dark:text-slate-100 font-sans antialiased">

  <div class="flex h-screen overflow-hidden">
    <!-- SIDEBAR NAVIGASI -->
    <aside class="w-64 bg-aetra-darkblue dark:bg-slate-950 text-slate-200 flex flex-col justify-between p-4 hidden md:flex border-r border-blue-900 dark:border-slate-800 shrink-0 h-full">
      <div>
        <div class="bg-white rounded-xl p-3 mb-6 shadow-md flex items-center justify-center">
          <img src="../logoaetra.jpg" alt="Logo Aetra Tangerang" class="h-8 object-contain" />
        </div>

        <nav class="space-y-1.5">
          <a href="index.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold bg-aetra-orange text-white shadow-md">
            📊 Overview SIMBA-IN
          </a>
          <a href="database.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-blue-100 hover:bg-aetra-blue hover:text-white transition">
            📂 Database & Input Cycle
          </a>
          <a href="verifikasi.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-blue-100 hover:bg-aetra-blue hover:text-white transition">
            ✔️ Verifikasi Reading
          </a>
          <a href="billing.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-blue-100 hover:bg-aetra-blue hover:text-white transition">
            🧾 Billing & Invoicing
          </a>
          <a href="audit.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-semibold text-blue-100 hover:bg-aetra-blue hover:text-white transition">
            📋 Log Audit & Aktivitas
          </a>
        </nav>
      </div>

      <div class="pt-4 border-t border-blue-800/60 text-[10px] text-blue-200/70">
        Aetra Tangerang © 2026
      </div>
    </aside>

    <!-- KONTEN UTAMA OVERVIEW -->
    <div class="flex-1 flex flex-col min-w-0 h-full overflow-y-auto">
      <header class="bg-white dark:bg-slate-800 border-b border-slate-200 dark:border-slate-700 p-4 flex justify-between items-center sticky top-0 z-20">
        <input id="searchInput" type="text" placeholder="Cari ID Pelanggan atau Nama Industri..." oninput="refreshDashboard()" class="w-80 px-4 py-2 border rounded-xl text-xs bg-slate-50 dark:bg-slate-700" />
        
        <div class="flex items-center gap-3">
          <select id="cycleFilter" onchange="refreshDashboard()" class="px-3 py-2 text-xs border rounded-xl dark:bg-slate-700">
            <option value="ALL">Semua Cycle (1-15)</option>
          </select>
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-full bg-aetra-orange text-white flex items-center justify-center font-bold text-xs">PY</div>
            <div>
              <p class="text-xs font-bold">Pak Yaya</p>
              <p class="text-[10px] text-slate-400">Billing Team</p>
            </div>
          </div>
        </div>
      </header>

      <main class="p-6 space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm">
            <h3 class="font-bold text-sm mb-2">Monitoring Pembacaan Cycle</h3>
            <div class="space-y-2 text-xs">
              <div class="flex justify-between border-b pb-1"><span>Total Target:</span><span id="cycleTotalCount" class="font-bold">0</span></div>
              <div class="flex justify-between border-b pb-1"><span>Selesai Dibaca:</span><span id="cycleCompletedCount" class="font-bold text-emerald-600">0</span></div>
              <div class="flex justify-between border-b pb-1"><span>Pending Reading:</span><span id="cyclePendingCount" class="font-bold text-aetra-orange">0</span></div>
              <div class="flex justify-between pt-1"><span>Rasio Keterbacaan:</span><span id="cyclePercentage" class="font-extrabold text-aetra-blue text-sm">0%</span></div>
            </div>
          </div>

          <div class="bg-white dark:bg-slate-800 p-5 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm flex flex-col items-center justify-center">
            <h3 class="font-bold text-xs uppercase mb-2">Visualisasi Keterbacaan</h3>
            <div class="w-full max-w-[200px] h-[180px]">
              <canvas id="cycleChart"></canvas>
            </div>
          </div>

          <div class="space-y-3">
            <a href="verifikasi.html" class="block bg-white dark:bg-slate-800 p-4 rounded-2xl border hover:border-aetra-orange flex justify-between items-center transition">
              <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase">Perlu Verifikasi Reading</p>
                <p id="countPending" class="text-xl font-black text-aetra-orange">0</p>
              </div>
              <span class="text-xl">🔍</span>
            </a>
            <a href="billing.html" class="block bg-white dark:bg-slate-800 p-4 rounded-2xl border hover:border-aetra-blue flex justify-between items-center transition">
              <div>
                <p class="text-[10px] font-bold text-slate-400 uppercase">Ready for Billing</p>
                <p id="countVerified" class="text-xl font-black text-aetra-blue">0</p>
              </div>
              <span class="text-xl">📋</span>
            </a>
          </div>
        </div>

        <div class="bg-white dark:bg-slate-800 rounded-2xl border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="p-4 border-b flex justify-between items-center bg-slate-50 dark:bg-slate-800">
            <h2 class="font-extrabold text-aetra-blue text-sm">Tabel Monitoring Pembacaan Meter Industri</h2>
            <button onclick="downloadPDFReport()" class="px-3 py-1.5 text-xs font-bold bg-rose-600 text-white rounded-xl hover:bg-rose-700 transition">📄 Cetak PDF</button>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
              <thead>
                <tr class="bg-slate-100 dark:bg-slate-700/50 text-slate-600 uppercase font-extrabold text-[10px]">
                  <th class="p-3.5">Pelanggan Industri</th>
                  <th class="p-3.5">Cycle</th>
                  <th class="p-3.5">Stand Lalu</th>
                  <th class="p-3.5">Stand Skrg</th>
                  <th class="p-3.5">Volume</th>
                  <th class="p-3.5">Total Tagihan</th>
                  <th class="p-3.5">Status</th>
                </tr>
              </thead>
              <tbody id="tableBody" class="divide-y divide-slate-100 dark:divide-slate-700 font-medium"></tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <script>
    let dataIndustri = JSON.parse(localStorage.getItem('aetra_industri_data')) || [
      { id: 'IND-1001', nama: 'PT Krakatau Steel Industry', email: 'billing@krakatau.co.id', cycle: 'Cycle 1', kelas: 'Gold', lalu: 12500, skrg: 13200, status: 'Verified' },
      { id: 'IND-1002', nama: 'PT Indah Kiat Pulp & Paper', email: 'finance@indahkiat.co.id', cycle: 'Cycle 1', kelas: 'Premium', lalu: 45000, skrg: 47500, status: 'Invoiced' },
      { id: 'IND-1003', nama: 'PT Gajah Tunggal Tbk', email: 'acc@gajahtunggal.co.id', cycle: 'Cycle 2', kelas: 'Platinum', lalu: 21000, skrg: 21800, status: 'Pending Verification' }
    ];

    let cycleChartInstance = null;

    document.addEventListener("DOMContentLoaded", () => {
      const el = document.getElementById('cycleFilter');
      for (let i = 1; i <= 15; i++) el.innerHTML += `<option value="Cycle ${i}">Cycle ${i}</option>`;
      refreshDashboard();
    });

    function refreshDashboard() {
      const searchTxt = document.getElementById('searchInput').value.toLowerCase();
      const cycleF = document.getElementById('cycleFilter').value;

      let filtered = dataIndustri.filter(i => (i.nama.toLowerCase().includes(searchTxt) || i.id.toLowerCase().includes(searchTxt)) && (cycleF === 'ALL' || i.cycle === cycleF));

      let totalTarget = dataIndustri.filter(i => cycleF === 'ALL' || i.cycle === cycleF).length;
      let totalCompleted = dataIndustri.filter(i => (cycleF === 'ALL' || i.cycle === cycleF) && i.status && i.status !== 'Pending Verification').length;
      let totalPending = dataIndustri.filter(i => (cycleF === 'ALL' || i.cycle === cycleF) && i.status === 'Pending Verification').length;

      document.getElementById('cycleTotalCount').innerText = totalTarget;
      document.getElementById('cycleCompletedCount').innerText = totalCompleted;
      document.getElementById('cyclePendingCount').innerText = totalPending;
      document.getElementById('cyclePercentage').innerText = (totalTarget > 0 ? Math.round((totalCompleted / totalTarget) * 100) : 0) + '%';
      
      document.getElementById('countPending').innerText = dataIndustri.filter(i => i.status === 'Pending Verification').length;
      document.getElementById('countVerified').innerText = dataIndustri.filter(i => i.status === 'Verified').length;

      renderChart(totalCompleted, totalPending);

      let tbody = document.getElementById('tableBody');
      tbody.innerHTML = '';
      filtered.forEach(item => {
        let vol = item.skrg - item.lalu;
        let total = (vol * 12500) + (vol > 1000 ? 10000 : 0);
        tbody.innerHTML += `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-700/30">
            <td class="p-3.5"><p class="font-bold">${item.nama}</p><p class="text-[10px] text-slate-400 font-mono">${item.id}</p></td>
            <td class="p-3.5 text-aetra-blue font-semibold">${item.cycle}</td>
            <td class="p-3.5 font-mono">${item.lalu.toLocaleString()}</td>
            <td class="p-3.5 font-mono font-bold">${item.skrg.toLocaleString()}</td>
            <td class="p-3.5 font-mono text-aetra-orange font-bold">${vol.toLocaleString()} m³</td>
            <td class="p-3.5 font-mono font-bold">Rp ${total.toLocaleString()}</td>
            <td class="p-3.5"><span class="px-2 py-1 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">${item.status}</span></td>
          </tr>
        `;
      });
    }

    function renderChart(completed, pending) {
      const ctx = document.getElementById('cycleChart');
      if (cycleChartInstance) cycleChartInstance.destroy();
      cycleChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Selesai', 'Pending'],
          datasets: [{ data: [completed, pending], backgroundColor: ['#10B981', '#E86216'] }]
        },
        options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
      });
    }

    function downloadPDFReport() {
      html2pdf().from(document.body).set({ margin: 0.5, filename: 'Laporan_Overview.pdf' }).save();
    }
  </script>
</body>
</html>
