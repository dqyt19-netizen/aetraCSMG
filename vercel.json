{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/loginpetugas",
      "destination": "/petugas/login.html"
    },
    {
      "source": "/loginpetugas.html",
      "destination": "/petugas/login.html"
    },
    {
      "source": "/petugas",
      "destination": "/petugas/login.html"
    },
    {
      "source": "/petugas/:path*",
      "destination": "/petugas/:path*"
    }
  ]
}
